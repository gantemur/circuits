{
  "name": "circuits-unfolded",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inspectable, browser-compatible linear circuit kernel",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=browser --format=esm --outfile=dist/browser.js",
    "build:app": "npm run build && node scripts/build-app.mjs",
    "build:site": "npm run build:app && node scripts/package-site.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "npm run build:app && node --test test/*.test.mjs",
    "demo": "npm run build && node examples/demo.mjs",
    "demo:diode": "npm run build && node examples/diode-demo.mjs",
    "preview": "node scripts/serve.mjs",
    "dev": "npm run build:app && npm run preview",
    "demo:diode-transient": "npm run build && node examples/diode-transient-demo.mjs",
    "demo:bjt": "npm run build && node examples/bjt-demo.mjs",
    "demo:rc-synthesis": "npm run build && node examples/rc-synthesis-demo.mjs"
  },
  "devDependencies": { "typescript": "5.9.3", "esbuild": "0.25.12" }
}
